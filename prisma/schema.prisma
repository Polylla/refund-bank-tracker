generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  IMPORTADOR
  REVISOR
}

enum EstadoMatching {
  MATCHEADO
  SIN_MATCH
}

enum EstadoRevisionFila {
  PENDIENTE
  APROBADA
  DESCARTADA
}

model Usuario {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  nombre    String?
  roles     Rol[]
  createdAt DateTime @default(now())

  importaciones     ImportacionExcel[]
  cambiosDeEstado   HistorialEstado[]
  filasRevisadas    FilaEnRevision[]

  @@map("usuarios")
}

model CasoReembolso {
  id               String   @id @default(cuid())
  // folio (OT) NO es único: la misma OT puede tener varias diligencias
  // distintas. La identidad real de un caso es folio + conceptoGasto
  // (ver specs/03-deteccion-duplicados.md).
  folio            String
  conceptoGasto    String
  // N BOLETA: numero de boleta/recibo que el receptor rinde para
  // cobrar un gasto puntual. No toda fila la trae. Es la clave real de
  // matching de documentos (ver specs/05-matching-documentos.md).
  nBoleta          String?
  posibleDuplicado Boolean  @default(false)
  datosImportados  Json
  estadoActual     String
  // Se completan automaticamente al cambiar el estado (ver
  // specs/04-estados-reembolso.md). datosImportados NO se modifica
  // cuando esto pasa: queda como snapshot historico del import original.
  fechaEnvioPago   DateTime?
  fechaPago        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  importacionId  String
  importacion    ImportacionExcel @relation(fields: [importacionId], references: [id])

  historial        HistorialEstado[]
  documentos       Documento[]
  filasEnRevision  FilaEnRevision[]

  @@index([folio, conceptoGasto])
  @@index([nBoleta])
  @@map("casos_reembolso")
}

model FilaEnRevision {
  id              String             @id @default(cuid())
  importacionId   String
  importacion     ImportacionExcel   @relation(fields: [importacionId], references: [id])
  casoExistenteId String
  casoExistente   CasoReembolso      @relation(fields: [casoExistenteId], references: [id])
  datosNuevos     Json
  estado          EstadoRevisionFila @default(PENDIENTE)
  fecha           DateTime           @default(now())

  revisadoPorId   String?
  revisadoPor     Usuario?           @relation(fields: [revisadoPorId], references: [id])
  fechaRevision   DateTime?

  @@map("filas_en_revision")
}

model HistorialEstado {
  id             String   @id @default(cuid())
  casoId         String
  caso           CasoReembolso @relation(fields: [casoId], references: [id])
  estadoAnterior String?
  estadoNuevo    String
  fecha          DateTime @default(now())

  usuarioId      String?
  usuario        Usuario? @relation(fields: [usuarioId], references: [id])

  @@map("historial_estados")
}

model Documento {
  id             String   @id @default(cuid())
  casoId         String?
  caso           CasoReembolso? @relation(fields: [casoId], references: [id])
  nombreArchivo  String
  tipoArchivo    String
  urlBlob        String
  fechaCarga     DateTime @default(now())
  estadoMatching EstadoMatching

  @@map("documentos")
}

model ImportacionExcel {
  id                    String   @id @default(cuid())
  nombreArchivoOriginal String
  fecha                 DateTime @default(now())
  usuarioId             String
  usuario               Usuario  @relation(fields: [usuarioId], references: [id])
  cantidadFilas         Int
  cantidadDuplicados    Int
  cantidadErrores       Int
  cantidadEnRevision    Int      @default(0)

  casos                 CasoReembolso[]
  filasEnRevision       FilaEnRevision[]

  @@map("importaciones_excel")
}
