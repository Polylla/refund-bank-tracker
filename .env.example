# Base de datos (Neon Postgres) — Task 1.2
DATABASE_URL=

# Autenticación (Clerk) — Task 1.4
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Vercel Blob Storage — Task 1.5
# Autenticación vía OIDC (recomendado, no requiere token estático):
# BLOB_STORE_ID y VERCEL_OIDC_TOKEN se generan automáticamente al correr `vercel env pull`
# y se refrescan solos en producción. No hace falta seteados a mano.
BLOB_STORE_ID=
